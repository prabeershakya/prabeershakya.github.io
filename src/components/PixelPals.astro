---
/**
 * Pixel pals: small water creatures that float UP through the hero, mixed in
 * with the bubbles — they surface below the bottom edge, rise slowly with a
 * gentle sway, exit at the top, and free themselves. One surfaces every 9–18 s,
 * so a few are usually drifting at once.
 *
 * The sprites are drawn once at build time into <template> elements via
 * PixelArt; the client script only clones a template, positions it, and lets
 * CSS carry it up. Their colours are literal hex on purpose — the crab must
 * stay red and the whale blue in every palette, so these do not ride the
 * --t-* tokens (the one sanctioned exception to the token rule).
 *
 * Spawns are skipped under reduced motion and while the pong easter egg owns
 * the background.
 */
import PixelArt from "./PixelArt.astro";

interface Pal {
	name: string;
	palette: Record<string, string>;
	map: string[];
}

const PALS: Pal[] = [
	{
		name: "fish",
		palette: { o: "#f2762e", k: "#26221d" },
		map: [
			"...oooo.....",
			"..oooooo..o.",
			".kooooooo.oo",
			".ooooooooooo",
			"..oooooo..o.",
			"...oooo.....",
		],
	},
	{
		name: "jellyfish",
		palette: { j: "#f7a8c4" },
		map: [
			"..jjjjjj..",
			".jjjjjjjj.",
			".jjjjjjjj.",
			"jjjjjjjjjj",
			"jjjjjjjjjj",
			".jj.jj.jj.",
			"..j..j..j.",
			"..j..j..j.",
			".j..j..j..",
			"j..j..j...",
		],
	},
	{
		name: "octopus",
		palette: { o: "#a06ee0", k: "#26221d" },
		map: [
			"..oooooo..",
			".oooooooo.",
			".ookooko..",
			".oooooooo.",
			"..oooooo..",
			".o.o..o.o.",
			".o.o..o.o.",
			"o..o..o..o",
			"o..o..o..o",
		],
	},
	{
		name: "crab",
		palette: { c: "#ff6b5e", k: "#26221d" },
		map: [
			".cc......cc.",
			".cc......cc.",
			"..c......c..",
			"..cccccccc..",
			".cckcccckcc.",
			".cccccccccc.",
			"..cccccccc..",
			".c.c....c.c.",
		],
	},
	{
		name: "whale",
		palette: { b: "#5a8fd8", w: "#f8f4e3", k: "#26221d" },
		map: [
			"..w.w.........",
			"....bbbbbb..b.",
			"..bbbbbbbb.bbb",
			".bkbbbbbbbbbbb",
			"bbbbbbbbbbbbbb",
			".bbbbbbbbbbbb.",
			"..wwwwwwwww...",
		],
	},
];
---

<div class="pals" aria-hidden="true">
	{PALS.map((pal) => (
		<template data-pal={pal.name}>
			<PixelArt map={pal.map} palette={pal.palette} />
		</template>
	))}
</div>

<script>
	const host = document.getElementById("top");
	const layer = document.querySelector<HTMLElement>(".pals");

	if (host && layer) {
		const templates = [...layer.querySelectorAll("template")];
		const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
		let visible = true;

		new IntersectionObserver(([entry]) => (visible = entry.isIntersecting), {
			threshold: 0.05,
		}).observe(host);

		/**
		 * Launch one pal from below the bottom edge. CSS carries it up through
		 * the hero at bubble speed; `animationend` frees it at the top.
		 */
		const spawn = () => {
			const tpl = templates[Math.floor(Math.random() * templates.length)]!;
			const sprite = tpl.content.firstElementChild?.cloneNode(true);
			if (!sprite) return;

			const sway = document.createElement("span");
			sway.className = "pal-sway";
			// Each pal sways on its own rhythm, like the bubbles' wobble.
			sway.style.animationDuration = `${2.4 + Math.random() * 2}s`;
			sway.append(sprite);

			const pal = document.createElement("span");
			pal.className = "pal";
			pal.style.left = `${3 + Math.random() * 88}%`;
			pal.style.animationDuration = `${16 + Math.random() * 8}s`;
			pal.append(sway);
			layer.append(pal);

			pal.addEventListener("animationend", () => pal.remove(), { once: true });
		};

		const schedule = () => {
			window.setTimeout(
				() => {
					// The pong easter egg gets the spotlight when it is on.
					if (visible && !document.hidden && document.documentElement.dataset.pong !== "on")
						spawn();
					schedule();
				},
				9000 + Math.random() * 9000,
			);
		};

		if (!reduced && templates.length) schedule();
	}
</script>

<style>
	.pals {
		position: absolute;
		inset: 0;
		z-index: 0;
		pointer-events: none;
		overflow: hidden;
	}

	/*
		.pal spans are created by the script at runtime, so they never receive
		Astro's scoping attribute — these rules must stay :global.
	*/
	:global(.pal) {
		position: absolute;
		bottom: -6rem;
		animation: pal-rise linear both;
		will-change: transform;
	}

	:global(.pal-sway) {
		display: block;
		animation: pal-sway ease-in-out infinite alternate;
	}

	:global(.pal svg) {
		display: block;
		width: clamp(36px, 4.5vw, 56px);
		height: auto;
	}

	/* Rise the full height of the hero and clear the top edge. */
	@keyframes pal-rise {
		from {
			transform: translateY(0);
		}
		to {
			transform: translateY(calc(-100svh - 12rem));
		}
	}

	@keyframes pal-sway {
		from {
			transform: translateX(-6px);
		}
		to {
			transform: translateX(6px);
		}
	}

	/* The script already refuses to spawn; this also hides any edge case. */
	@media (prefers-reduced-motion: reduce) {
		.pals {
			display: none;
		}
	}
</style>
