---
import { skills } from "../data/skills";

/*
 * Seamless marquee: the list is rendered twice and the track animates
 * -50%. The duplicate is aria-hidden — it exists so the loop has no seam,
 * not as content. Pauses on hover; under reduced motion the global guard
 * freezes the animation, so the first copy simply sits there, readable.
 */
const items = [...skills];
---

<div class="ticker" aria-label="Skills and tools">
	<div class="ticker-track">
		{[false, true].map((hidden) => (
			<ul class="ticker-list" aria-hidden={hidden || undefined}>
				{items.map((skill) => (
					<li>
						<span class="ticker-item">
							<span class="ticker-star" aria-hidden="true">
								▚
							</span>
							{skill}
						</span>
					</li>
				))}
			</ul>
		))}
	</div>
</div>

<style>
	.ticker {
		overflow: hidden;
		border-block: 1px solid var(--border-subtle);
		background: var(--bg-deep);
	}

	.ticker-track {
		display: flex;
		width: max-content;
	}

	@media (prefers-reduced-motion: no-preference) {
		.ticker-track {
			animation: ticker-scroll 36s linear infinite;
		}

		.ticker:hover .ticker-track {
			animation-play-state: paused;
		}
	}

	@keyframes ticker-scroll {
		from {
			transform: translateX(0);
		}
		to {
			transform: translateX(-50%);
		}
	}

	.ticker-list {
		display: flex;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.ticker-item {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		font-family: var(--font-mono);
		font-size: 0.78rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--text-muted);
		padding: 0.75rem 1.1rem;
		white-space: nowrap;
	}

	.ticker-star {
		color: var(--brand);
		font-size: 0.7rem;
	}
</style>
