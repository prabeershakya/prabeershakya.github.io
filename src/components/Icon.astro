---
/**
 * Brand and UI icons, inline.
 *
 * Paths come from the `../Web` sibling (GitHub, LinkedIn, HackTheBox,
 * TryHackMe brand marks) plus one stroke icon for email. Everything renders
 * in `currentColor` so the surrounding link's hover colour carries through;
 * the HTB mark was a solid `var(--ink)` fill there and is currentColor here.
 */
interface Props {
	name: "mail" | "github" | "linkedin" | "hackthebox" | "tryhackme";
	size?: number;
}

const { name, size = 20 } = Astro.props;
---

{name === "mail" && (
	<svg
		viewBox="0 0 24 24"
		width={size}
		height={size}
		fill="none"
		stroke="currentColor"
		stroke-width="2.2"
		stroke-linecap="round"
		stroke-linejoin="round"
		aria-hidden="true"
	>
		<rect x="2" y="4" width="20" height="16" rx="2" />
		<path d="m22 7-10 6L2 7" />
	</svg>
)}
{name === "github" && (
	<svg viewBox="0 0 24 24" width={size} height={size} fill="currentColor" aria-hidden="true">
		<path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.28-.01-1.02-.02-2-3.2.7-3.88-1.54-3.88-1.54-.52-1.33-1.28-1.68-1.28-1.68-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.72-1.54-2.55-.29-5.23-1.28-5.23-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0C17.3 5.5 18.27 5.81 18.27 5.81c.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.09 0 4.42-2.69 5.39-5.25 5.68.41.35.77 1.04.77 2.1 0 1.52-.01 2.74-.01 3.11 0 .31.21.68.8.56A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z" />
	</svg>
)}
{name === "linkedin" && (
	<svg viewBox="0 0 24 24" width={size} height={size} fill="currentColor" aria-hidden="true">
		<path d="M4.98 3.5A2.5 2.5 0 1 1 0 3.5a2.5 2.5 0 0 1 4.98 0ZM.5 8h4.5V24H.5zm7.5 0h4.31v2.2h.06c.6-1.14 2.07-2.34 4.26-2.34 4.56 0 5.4 3 5.4 6.9V24h-4.5v-8.1c0-1.93-.04-4.42-2.7-4.42-2.7 0-3.11 2.1-3.11 4.28V24H8Z" />
