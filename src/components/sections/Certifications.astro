---
/*
	`verify` is the public credential/badging URL. Google has no per-certificate
	verification link to publish, so that entry is listed without one rather
	than linking to a course page that would not actually verify it.
*/
import Icon from "../Icon.astro";

const certs = [
	{
		name: "APIsec Certified Practitioner",
		status: "api security · OWASP API Top 10",
		verify: "https://www.credly.com/badges/ed433c1e-2480-4190-89c5-617411590548",
	},
	{
		name: "Google Cybersecurity Professional",
		status: "foundations · career ready",
		verify: undefined,
	},
	{
		name: "Certified Cybersecurity Educator Professional (CCEP)",
		status: "teaching security, the right way",
		verify: "https://courses.redteamleaders.com/exam-completion/e896c352f75253db",
	},
];
---

<section id="certifications" class="section">
	<div class="container">
		<div class="section-head reveal">
			<p class="sec-label">04 — certifications</p>
			<h2 class="section-title">
				<span class="title-icon">
					<Icon name="award" size={22} />
				</span>
				CERTIFIED <span class="hl">&</span> CREDENTIALED
			</h2>
			<p class="section-copy mono">
				hands-on work first, certificates second — but the paper still helps.
			</p>
		</div>

		<div class="cert-list bento reveal">
			{certs.map((cert) =>
				cert.verify ? (
					<a class="cert card b2" data-hoverable href={cert.verify} target="_blank" rel="noopener">
						<span class="cert-row">
							<span class="cert-name">{cert.name}</span>
							<span class="cert-status mono">{cert.status}</span>
						</span>
						<span class="cert-cta mono">
							<Icon name="external" size={13} /> verify
						</span>
					</a>
				) : (
					<div class="cert card b2">
						<span class="cert-row">
							<span class="cert-name">{cert.name}</span>
							<span class="cert-status mono">{cert.status}</span>
						</span>
					</div>
				),
			)}
		</div>
	</div>
</section>

<style>
	.section-copy {
		font-size: 0.85rem;
		color: var(--text-muted);
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}

	.cert-list {
		max-width: 72rem;
		margin-inline: auto;
	}

	.cert {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1rem;
		height: 100%;
		padding: 1.1rem 1.3rem;
		text-decoration: none;
	}

	.cert-cta {
		margin-top: auto;
	}

	.cert-row {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		min-width: 0;
	}

	.cert-name {
		font-weight: 600;
		font-size: clamp(1.05rem, 2vw, 1.35rem);
		letter-spacing: -0.01em;
		color: var(--text);
		overflow-wrap: anywhere;
	}

	.cert-status {
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--text-muted);
	}

	.cert-cta {
		flex: none;
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--brand);
	}
</style>
