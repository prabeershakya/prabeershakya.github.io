---
import { profile, handles } from "../../data/profile";
import Icon from "../Icon.astro";
---

<section id="contact" class="section">
	<div class="container">
		<div class="section-head reveal">
			<p class="sec-label">06 — contact</p>
			<h2 class="section-title">
				WANT TO TALK <span class="hl">SECURITY</span>?
			</h2>
			<p class="contact-copy">
				Internships, CTF collabs, weird vulns or just nerding out over packet captures — my inbox is
				open.
			</p>
		</div>

		<div class="way-list bento reveal">
			<a class="way card b3" data-hoverable href={`mailto:${profile.email}`}>
				<span class="way-icon" aria-hidden="true">
					<Icon name="mail" />
				</span>
				<span class="way-label mono">email</span>
				<span class="way-value mono">{profile.email}</span>
				<span class="way-arrow" aria-hidden="true">
					↗
				</span>
			</a>
			<a class="way card b3" data-hoverable href={profile.github} target="_blank" rel="noopener">
				<span class="way-icon" aria-hidden="true">
					<Icon name="github" />
				</span>
				<span class="way-label mono">github</span>
				<span class="way-value mono">{handles.github}</span>
				<span class="way-arrow" aria-hidden="true">
					↗
				</span>
			</a>
			<a class="way card b2" data-hoverable href={profile.linkedin} target="_blank" rel="noopener">
				<span class="way-icon" aria-hidden="true">
					<Icon name="linkedin" />
				</span>
				<span class="way-label mono">linkedin</span>
				<span class="way-value mono">{handles.linkedin}</span>
				<span class="way-arrow" aria-hidden="true">
					↗
				</span>
			</a>
			<a
				class="way card b2"
				data-hoverable
				href={profile.hackthebox}
				target="_blank"
				rel="noopener"
			>
				<span class="way-icon" aria-hidden="true">
					<Icon name="hackthebox" />
				</span>
				<span class="way-label mono">hackthebox</span>
				<span class="way-value mono">Prabeer Shakya</span>
				<span class="way-arrow" aria-hidden="true">
					↗
				</span>
			</a>
			<a class="way card b2" data-hoverable href={profile.tryhackme} target="_blank" rel="noopener">
				<span class="way-icon" aria-hidden="true">
					<Icon name="tryhackme" />
				</span>
				<span class="way-label mono">tryhackme</span>
				<span class="way-value mono">{handles.tryhackme}</span>
				<span class="way-arrow" aria-hidden="true">
					↗
				</span>
			</a>
		</div>
	</div>
</section>

<style>
	.contact-copy {
		font-size: 1rem;
		color: var(--text-secondary);
		max-width: 54ch;
		text-wrap: pretty;
	}

	.way-list {
		max-width: 72rem;
		margin-inline: auto;
	}

	.way {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: 1rem 1.2rem;
		text-decoration: none;
	}

	/*
		Hairline icon box, matching the card language. The icon inherits the
		row's colour and takes the brand on hover with the row.
	*/
	.way-icon {
		flex: none;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 38px;
		height: 38px;
		color: var(--text-secondary);
		background: var(--surface-2);
		box-shadow: 0 0 0 1px var(--border-subtle);
		transition:
			color var(--ease),
			box-shadow var(--ease);
	}

	.way-icon :global(svg) {
		width: 20px;
		height: 20px;
	}

	@media (hover: hover) {
		.way:hover .way-icon {
			color: var(--brand);
			box-shadow: 0 0 0 1px var(--border-strong);
		}
	}

	.way-label {
		flex: none;
		width: 5.5rem;
		font-size: 0.68rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--text-muted);
	}

	.way-value {
		flex: 1;
		min-width: 0;
		font-size: clamp(0.9rem, 1.8vw, 1.1rem);
		font-weight: 500;
		color: var(--text);
		overflow-wrap: anywhere;
	}

	.way-arrow {
		flex: none;
		color: var(--brand);
		font-size: 1rem;
	}

	@media (max-width: 640px) {
		.way {
			flex-wrap: wrap;
		}

		.way-label {
			width: auto;
		}
	}
</style>
