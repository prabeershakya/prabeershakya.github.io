---
import { profile } from "../../data/profile";
import TerminalArt from "../TerminalArt.astro";
import MarkDraw from "../MarkDraw.astro";
import Bubbles from "../Bubbles.astro";
import PongGame from "../PongGame.astro";
import PixelBits from "../PixelBits.astro";
import Icon from "../Icon.astro";
---

<section id="top" class="hero">
	<Bubbles />
	<PongGame />
	<PixelBits />
	<div class="container hero-inner">
		<div class="hero-panel">
			<div class="hero-left">
				<p class="sec-label reveal">portfolio // cyber security learner</p>

				<h1 class="hero-name reveal">
					PRABEER MAN
					<br />
					<span class="hl">SHAKYA</span>
					<span class="cursor" aria-hidden="true">
						_
					</span>
				</h1>

				<p class="hero-tag reveal">
					<span class="strike">hacks</span>
					<MarkDraw>ethically</MarkDraw>
					<span class="hl" aria-hidden="true">
						.
					</span>
				</p>

				<div class="chip-row reveal">
					<span class="chip">
						<span class="chip-dot"></span> open to internships
					</span>
					<span class="chip">pentesting · ctf</span>
				</div>

				<div class="hero-cta reveal">
					<a class="btn btn-accent" href="#projects">
						<Icon name="arrow-right" size={15} /> view work
					</a>
					<a class="btn" href={profile.linkedin} target="_blank" rel="noopener">
						<Icon name="linkedin" size={15} /> linkedin
					</a>
				</div>
			</div>

			<div class="hero-right reveal">
				<div class="terminal">
					<TerminalArt />
				</div>
				<p class="hero-quote">learning the depth of the web, one strand at a time.</p>
			</div>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		min-height: calc(100svh - var(--nav-h));
		display: flex;
		align-items: center;
		padding-block: clamp(3rem, 8vh, 5rem) clamp(2rem, 5vh, 3rem);
	}

	.hero-inner {
		/* Bubbles sit at z 0, the pong easter egg at z 1 — content above both. */
		position: relative;
		z-index: 2;
	}

	/*
		One frosted card behind everything: the name column and the terminal
		share a single background so the animation layer (bubbles, pong, pals)
		never sits directly behind bare text. A near-opaque `color-mix` keeps
		text readable even where `backdrop-filter` is unsupported, and the
		hairline elevation is the house card language.
	*/
	.hero-panel {
		background: color-mix(in srgb, var(--surface) 90%, transparent);
		backdrop-filter: blur(8px);
		box-shadow: var(--elevation);
		padding: clamp(1.1rem, 2.4vw, 1.8rem);
		display: flex;
		align-items: center;
		gap: clamp(1.2rem, 3vw, 2.4rem);
		width: 100%;
	}

	.hero-left {
		flex: 1 1 54%;
		min-width: 0;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1.4rem;
	}

	.hero-name {
		font-size: clamp(2.4rem, 5.6vw, 4.2rem);
		font-weight: 700;
		text-transform: uppercase;
	}

	.cursor {
		color: var(--brand);
		font-weight: 500;
		animation: cursor-blink 1.3s step-end infinite;
	}

	@keyframes cursor-blink {
		0%,
		100% {
			opacity: 1;
		}
		50% {
			opacity: 0;
		}
	}

	.hero-tag {
		font-family: var(--font-mono);
		font-size: clamp(1.05rem, 2vw, 1.3rem);
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--text-secondary);
	}

	.strike {
		text-decoration: line-through 2px var(--brand);
	}

	.hero-cta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
	}

	.hero-right {
		flex: 0 1 46%;
		max-width: min(100%, 540px);
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.terminal {
		/*
			No box of its own: the pixel SVG draws the terminal window — frame,
			title bar, dots — so an outer card here would be a border around a
			border. Only breathing room against the frosted panel.
		*/
		padding: 0.75rem 0.25rem 0.25rem;
	}

	.terminal :global(svg) {
		width: 100%;
		height: auto;
	}

	.hero-quote {
		font-family: var(--font-mono);
		font-size: 0.82rem;
		color: var(--text-muted);
		line-height: 1.7;
	}

	@media (max-width: 860px) {
		.hero-panel {
			flex-direction: column-reverse;
			align-items: stretch;
		}

		.hero-left,
		.hero-right {
			flex: 1 1 auto;
			width: 100%;
			max-width: none;
		}
	}
</style>
