---
import { profile } from "../../data/profile";
import TerminalArt from "../TerminalArt.astro";
import MarkDraw from "../MarkDraw.astro";
import Bubbles from "../Bubbles.astro";
import PongGame from "../PongGame.astro";
---

<section id="top" class="hero">
	<Bubbles />
	<PongGame />
	<div class="container hero-inner">
		<div class="hero-left">
			<p class="sec-label reveal">portfolio // cyber security learner</p>

			<h1 class="hero-name reveal">
				PRABEER MAN
				<br />
				<span class="hl">SHAKYA</span>
				<span class="cursor" aria-hidden="true">
					_
				</span>
			</h1>

			<p class="hero-tag reveal">
				<span class="strike">hacks</span>
				<MarkDraw>ethically</MarkDraw>
				<span class="hl" aria-hidden="true">
					.
				</span>
			</p>

			<div class="chip-row reveal">
				<span class="chip">
					<span class="chip-dot"></span> open to internships
				</span>
				<span class="chip">
					<span class="chip-dot"></span> currently: pentesting
				</span>
				<span class="chip">toolkit: nmap · burp · wireshark</span>
			</div>

			<div class="hero-cta reveal">
				<a class="btn btn-accent" href="#projects">
					view work
				</a>
				<a class="btn" href={profile.linkedin} target="_blank" rel="noopener">
					linkedin ↗
				</a>
			</div>
		</div>

		<div class="hero-right reveal">
			<div class="terminal">
				<TerminalArt />
			</div>
			<p class="hero-quote">
				<span class="mono status-line">
					<span class="pulse" aria-hidden="true"></span> online / learning
				</span>
				learning the depth of the web, one strand at a time.
			</p>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		min-height: calc(100svh - var(--nav-h));
		display: flex;
		align-items: center;
		padding-block: clamp(3rem, 8vh, 5rem) clamp(2rem, 5vh, 3rem);
	}

	.hero-inner {
		/* Bubbles sit at z 0, the pong easter egg at z 1 — content above both. */
		position: relative;
		z-index: 2;
		display: flex;
		align-items: center;
		gap: clamp(2rem, 5vw, 4rem);
	}

	/*
		Frosted panels over the animation layer. The bubbles/pong canvas runs
		behind the hero, so the two content columns get a translucent surface
		(a near-opaque `color-mix`, so text stays readable even where
		`backdrop-filter` is unsupported) with the house hairline elevation —
		card language, but scoped to the text, not the whole section.
	*/
	.hero-left,
	.hero-right {
		background: color-mix(in srgb, var(--surface) 90%, transparent);
		backdrop-filter: blur(8px);
		box-shadow: var(--elevation);
		padding: clamp(1.4rem, 3vw, 2.2rem);
	}

	.hero-left {
		flex: 1 1 60%;
		min-width: 0;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1.4rem;
	}

	.hero-name {
		font-size: clamp(2.4rem, 5.6vw, 4.2rem);
		font-weight: 700;
		text-transform: uppercase;
	}

	.cursor {
		color: var(--brand);
		font-weight: 500;
		animation: cursor-blink 1.3s step-end infinite;
	}

	@keyframes cursor-blink {
		0%,
		100% {
			opacity: 1;
		}
		50% {
			opacity: 0;
		}
	}

	.hero-tag {
		font-family: var(--font-mono);
		font-size: clamp(1.05rem, 2vw, 1.3rem);
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--text-secondary);
	}

	.strike {
		text-decoration: line-through 2px var(--brand);
	}

	.hero-cta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
	}

	.hero-right {
		flex: 0 1 40%;
		max-width: min(100%, 420px);
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.terminal {
		/*
			No box of its own: the pixel SVG draws the terminal window — frame,
			title bar, dots — so an outer card here would be a border around a
			border. Only breathing room against the frosted panel.
		*/
		padding: 0.75rem 0.25rem 0.25rem;
	}

	.terminal :global(svg) {
		width: 100%;
		height: auto;
	}

	.hero-quote {
		font-family: var(--font-mono);
		font-size: 0.82rem;
		color: var(--text-muted);
		line-height: 1.7;
	}

	.status-line {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--text-secondary);
		margin-right: 0.5rem;
	}

	.pulse {
		width: 8px;
		height: 8px;
		flex: none;
		background: var(--brand);
	}

	@media (prefers-reduced-motion: no-preference) {
		.pulse {
			animation: pulse 2.4s cubic-bezier(0.2, 0, 0, 1) infinite;
		}

		@keyframes pulse {
			0% {
				box-shadow: 0 0 0 0 color-mix(in srgb, var(--brand) 70%, transparent);
			}
			70% {
				box-shadow: 0 0 0 7px color-mix(in srgb, var(--brand) 0%, transparent);
			}
			100% {
				box-shadow: 0 0 0 0 color-mix(in srgb, var(--brand) 0%, transparent);
			}
		}
	}

	@media (max-width: 860px) {
		.hero-inner {
			flex-direction: column-reverse;
		}

		.hero-left,
		.hero-right {
			flex: 1 1 auto;
			width: 100%;
			max-width: none;
		}
	}
</style>
