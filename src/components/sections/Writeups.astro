---
import { writeups, writeupSource, type Severity } from "../../data/writeups";
import Icon from "../Icon.astro";

/** How many writeups to show. Six tiles read well without crowding. */
const CAP = 6;

/*
	Only the first two tags are rendered; the rest collapse to a `+N` count so
	the tile never reflows because someone added a third tag.
*/
const TAG_VISIBLE = 2;
const visibleTags = (tags: string[]) => tags.slice(0, TAG_VISIBLE);
const overflowTags = (tags: string[]) => Math.max(0, tags.length - TAG_VISIBLE);

/** Severity drives the tile's left rule colour, warm-to-cool by seriousness. */
const SEVERITY_COLOR: Record<Severity, string> = {
	critical: "#ff6b6b",
	high: "#ff865e",
	medium: "#ffd93d",
	low: "#4cc9f0",
	info: "var(--border-strong)",
};
---

<section id="writeups" class="section">
	<div class="container">
		<div class="section-head reveal">
			<p class="sec-label">05 — writeups</p>
			<h2 class="section-title">
				<span class="title-icon">
					<Icon name="file-text" size={22} />
				</span>
				THINGS I <span class="hl">BROKE</span>, WRITTEN UP
			</h2>
			<div class="chip-row">
				<span class="chip">
					<span class="chip-dot"></span>
					{writeupSource === "fetched" ? `${writeups.length} published` : "sample entries"}
				</span>
				{writeupSource === "placeholder" && <span class="chip">no writeups published yet</span>}
				<span class="chip">disclosures + research</span>
				<span class="chip">no exploit code</span>
			</div>
		</div>

		{writeups.length === 0 ? (
			<p class="empty mono reveal">
				Nothing published yet. Entries live in <code>src/data/writeups.ts</code> — add one and it
				appears here.
			</p>
		) : (
			<div class="wu-grid bento reveal">
				{writeups.slice(0, CAP).map((w, i) => (
					<article
						class:list={["wu", "card", i === 0 ? "b3 btall wu-lead" : i < 3 ? "b3" : "b2"]}
						data-hoverable
						style={`--sev:${SEVERITY_COLOR[w.severity]}`}
					>
						<span class="wu-head">
							<span class="wu-source mono">
								<Icon name="file-text" size={12} /> {w.source}
							</span>
							<span class="wu-date mono">{w.date}</span>
						</span>
						<span class="wu-title">{w.title}</span>
						<span class="wu-summary">{w.summary}</span>
						<span class="wu-foot">
							{visibleTags(w.tags).map((tag) => (
								<span class="tag">{tag}</span>
							))}
							{overflowTags(w.tags) > 0 && (
								<span class="wu-more mono">+{overflowTags(w.tags)}</span>
							)}
							<span class="wu-sev mono">{w.severity}</span>
							{w.url && (
								<a
									class="wu-link"
									href={w.url}
									target="_blank"
									rel="noopener"
									aria-label={`${w.title} — read (new tab)`}
								/>
							)}
						</span>
					</article>
				))}
			</div>
		)}
	</div>
</section>

<style>
	.wu-grid {
		max-width: 72rem;
		margin-inline: auto;
	}

	/*
		`--sev` is set inline per tile from `SEVERITY_COLOR`. The 3px left rule
		carries severity as a colour channel, and the word in the footer carries
		it as text — a reader who cannot separate the hues still reads it.
	*/
	.wu {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
		padding: 1.1rem 1.2rem;
		padding-inline-start: 1.35rem;
	}

	/* The lead writeup: bigger voice, fills its tall tile. */
	.wu-lead .wu-title {
		font-size: clamp(1.25rem, 2.2vw, 1.7rem);
	}

	.wu-lead .wu-summary {
		-webkit-line-clamp: 5;
		max-width: none;
	}

	.wu::before {
		content: "";
		position: absolute;
		left: 0;
		top: 0;
		bottom: 0;
		width: 3px;
		background: var(--sev);
	}

	.wu-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.5rem;
	}

	.wu-source {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-size: 0.68rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--text-muted);
		min-width: 0;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.wu-date {
		flex: none;
		font-size: 0.68rem;
		font-variant-numeric: tabular-nums;
		color: var(--text-secondary);
	}

	.wu-title {
		font-weight: 600;
		font-size: clamp(0.98rem, 1.4vw, 1.15rem);
		line-height: 1.2;
		color: var(--text);
		overflow-wrap: anywhere;
	}

	.wu-summary {
		font-size: 0.84rem;
		line-height: 1.5;
		color: var(--text-secondary);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		text-wrap: pretty;
	}

	.wu-foot {
		margin-top: auto;
		padding-top: 0.3rem;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.4rem;
	}

	.wu-more {
		font-size: 0.68rem;
		color: var(--text-muted);
	}

	.wu-sev {
		margin-left: auto;
		font-size: 0.64rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--sev);
	}

	.wu-link {
		position: absolute;
		inset: 0;
		z-index: 1;
	}

	.empty {
		font-size: 0.85rem;
		color: var(--text-muted);
		line-height: 1.7;
		max-width: 46ch;
	}

	.empty code {
		background: var(--surface);
		box-shadow: var(--elevation);
		padding: 0 0.3em;
		color: var(--text);
	}

	@media (max-width: 780px) {
		.wu-summary {
			max-width: none;
		}
	}
</style>
