---
/**
 * The hero terminal, redesigned as a LIVE STATUS MONITOR: a bigger pixel
 * window titled STATUS.SH that boots a dashboard of facts row by row, then
 * keeps the STATUS row cycling like a hud. Data comes from the real data
 * files — total CTF events entered and best finish come from `teams.ts`, so
 * a build refresh updates the screen.
 *
 * SSR renders one complete static frame (the full dashboard, cursor parked at
 * the end of the STATUS value), so the art is fully present without JavaScript
 * and under reduced motion — the script only takes over the boot + cycle when
 * it can run. Text is drawn with the shared 3x5 pixel font
 * (`src/lib/pixel-font.ts`); frame and title bar are plain rects. All colours
 * are theme tokens, so the scene re-tints with the palette switcher.
 *
 * The frontmatter computes the dashboard and hands it to the script through a
 * `data-dashboard` attribute — one source of truth for the data (the script
 * cannot import `teams.ts`; it pulls in `node:fs`). Geometry and colours are
 * the only things mirrored in the script, and the frontmatter throws the
 * build if a character has no glyph, so a bad edit fails loudly.
 */
import { teams, placeLabel, type TeamResult } from "../data/teams";
import { GLYPHS, ADVANCE, CHAR_W, CHAR_H, textWidth } from "../lib/pixel-font";

/* ------------------------------ geometry ---------------------------------- */

const COLS = 88;
const ROWS = 35;
/** Text window: inside the 1-cell frame, under the 2-row title bar. */
const PAD = 2;
const TEXT_TOP = 4;
/** Dashboard pitch: one glyph block (5 rows) plus one blank row. */
const PITCH = 6;
/** Label column width, in characters (labels are padEnd-ed to this). */
const LABEL_W = 8;
const LABEL_CELLS = textWidth(" ".repeat(LABEL_W));

/* -------------------------------- the data --------------------------------- */

const totalEntered = teams.reduce((n, t) => n + t.totalEvents, 0);
const allResults = teams.flatMap((t) => t.results);
const best = allResults.reduce<TeamResult | undefined>(
	(b, r) => (b == null || r.place < b.place ? r : b),
	undefined,
);
const bestScale = best?.scale?.match(/\d+/)?.[0];
const bestLabel = best
	? `${placeLabel(best.place).toUpperCase()}${bestScale ? ` OF ${bestScale}` : ""}`
	: "-";

type Row = readonly [label: string, value: string];

const DASH: Row[] = [
	["FOCUS", "PENTEST+CTF"],
	["EVENTS", `${totalEntered} ENTERED`],
	["BEST", bestLabel],
	["PROFILE", "HTB+THM"],
	["STATUS", "OPEN TO WORK"],
];

const STATUSES: string[] = [
	"OPEN TO WORK",
	"SOLVING CTF",
	"LEARN: BURP",
	"ON A HTB BOX",
	"READING RTFM",
];

const TITLE = "STATUS.SH";

/*
	Every character used on screen must exist in the pixel font — the build
	fails here rather than shipping blank glyphs.
*/
for (const [label, value] of DASH) {
	for (const ch of `${label}${value}${TITLE}`.toUpperCase()) {
		if (!GLYPHS[ch]) throw new Error(`TerminalArt: glyph missing for "${ch}"`);
	}
}
for (const status of STATUSES) {
	for (const ch of status.toUpperCase()) {
		if (!GLYPHS[ch]) throw new Error(`TerminalArt: glyph missing for "${ch}"`);
	}
}

/* --------------------------- static SSR frame ------------------------------ */

interface Cell {
	x: number;
	y: number;
	fill: string;
}

const frameCells: Cell[] = [];
/** Outer frame + the two title-bar rules. */
for (let x = 0; x < COLS; x++) {
	frameCells.push({ x, y: 0, fill: "var(--border-strong)" });
	frameCells.push({ x, y: 2, fill: "var(--border-strong)" });
	frameCells.push({ x, y: ROWS - 1, fill: "var(--border-strong)" });
}
for (let y = 0; y < ROWS; y++) {
	frameCells.push({ x: 0, y, fill: "var(--border-strong)" });
	frameCells.push({ x: COLS - 1, y, fill: "var(--border-strong)" });
}
/** Title bar between the rules: three window dots, then the running title. */
const DOTS: [number, string][] = [
	[3, "#ff6b6b"],
	[5, "#ffd93d"],
	[7, "var(--brand)"],
];
for (let x = 1; x < COLS - 1; x++) {
	frameCells.push({ x, y: 1, fill: "var(--surface-2)" });
}
for (const [x, fill] of DOTS) {
	frameCells.push({ x, y: 1, fill });
}

/** One line of text as cells, at a given top row. */
function textCells(text: string, col: number, row: number, fill: string): Cell[] {
	const cells: Cell[] = [];
	for (const [i, ch] of [...text.toUpperCase()].entries()) {
		const glyph = GLYPHS[ch];
		if (!glyph) continue;
		for (const [gy, bits] of glyph.entries()) {
			for (const bit of [2, 1, 0]) {
				if ((bits >> bit) & 1) {
					cells.push({ x: col + i * ADVANCE + (2 - bit), y: row + gy, fill });
				}
			}
		}
	}
	return cells;
}

const [statusLabel, statusValue] = DASH[DASH.length - 1]!;
const staticCells: Cell[] = [
	...textCells(TITLE, 11, 1, "var(--text-secondary)"),
	...DASH.flatMap(([label, value], i) => {
		const top = TEXT_TOP + i * PITCH;
		return [
			...textCells(label.padEnd(LABEL_W), PAD, top, "var(--brand)"),
			...textCells(value, PAD + LABEL_CELLS, top, "var(--text-secondary)"),
		];
	}),
];
const cursorCol = PAD + textWidth(statusLabel.padEnd(LABEL_W) + statusValue) + 1;
const cursorRow = TEXT_TOP + (DASH.length - 1) * PITCH;
---

<svg
	class="terminal-art"
	viewBox={`0 0 ${COLS} ${ROWS}`}
	shape-rendering="crispEdges"
	role="img"
	aria-label="Live pixel status monitor showing CTF and learning stats"
	data-dashboard={JSON.stringify({ rows: DASH, statuses: STATUSES })}
>
	{frameCells.map((cell) => (
		<rect x={cell.x} y={cell.y} width={1.02} height={1.02} fill={cell.fill} />
	))}
	<g class="screen">
		{staticCells.map((cell) => (
			<rect x={cell.x} y={cell.y} width={1.02} height={1.02} fill={cell.fill} />
		))}
	</g>
	<rect
		class="cursor"
		x={cursorCol}
		y={cursorRow}
		width={CHAR_W}
		height={CHAR_H}
		fill="var(--brand)"
	/>
</svg>

<script>
	import { GLYPHS, ADVANCE, textWidth } from "../lib/pixel-font";

	/*
		Mirrors the frontmatter geometry. The dashboard DATA itself arrives via
		the data-dashboard attribute — the frontmatter is the single source of
		truth, and it throws the build if any character has no glyph.
	*/
	const PAD = 2;
	const TEXT_TOP = 4;
	const PITCH = 6;
	const LABEL_W = 8;
	const LABEL_CELLS = textWidth(" ".repeat(LABEL_W));

	const TYPE_MS = 34;
	const ROW_GAP_MS = 150;
	const CYCLE_MS = 3200;

	const svg = document.querySelector<SVGElement>(".terminal-art");
	const dashboard = JSON.parse(svg?.dataset.dashboard ?? "null") as {
		rows: [string, string][];
		statuses: string[];
	} | null;

	if (svg && dashboard && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
		const screen = svg.querySelector<SVGElement>(".screen");
		const cursor = svg.querySelector<SVGRectElement>(".cursor");
		const NS = "http://www.w3.org/2000/svg";
		const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));

		/** Draws one line of pixel text into a group. */
		const draw = (text: string, row: number, fill: string, parent: SVGElement) => {
			for (const [i, ch] of [...text.toUpperCase()].entries()) {
				const glyph = GLYPHS[ch];
				if (!glyph) continue;
				for (const [gy, bits] of glyph.entries()) {
					for (const bit of [2, 1, 0]) {
						if ((bits >> bit) & 1) {
							const rect = document.createElementNS(NS, "rect");
							rect.setAttribute("x", String(PAD + i * ADVANCE + (2 - bit)));
							rect.setAttribute("y", String(row + gy));
							rect.setAttribute("width", "1.02");
							rect.setAttribute("height", "1.02");
							rect.setAttribute("fill", fill);
							parent.appendChild(rect);
						}
					}
				}
			}
		};

		const parkCursor = (col: number, row: number) => {
			cursor?.setAttribute("x", String(col));
			cursor?.setAttribute("y", String(row));
		};

		const groups: SVGElement[] = [];

		/**
		 * Types one dashboard row: label appears at once (brand colour), the
		 * value types after it (secondary colour), cursor riding its tail.
		 */
		const typeRow = async (i: number, label: string, value: string) => {
			const top = TEXT_TOP + i * PITCH;
			let g = groups[i];
			if (!g) {
				g = document.createElementNS(NS, "g");
				screen?.appendChild(g);
				groups[i] = g;
			}
			while (g.firstChild) g.firstChild.remove();
			draw(label.padEnd(LABEL_W), top, "var(--brand)", g);

			const start = PAD + LABEL_CELLS;
			for (const [n] of [...value].entries()) {
				g.querySelector(".value")?.remove();
				const valueG = document.createElementNS(NS, "g");
				valueG.setAttribute("class", "value");
				g.appendChild(valueG);
				draw(value.slice(0, n + 1), top, "var(--text-secondary)", valueG);
				parkCursor(start + textWidth(value.slice(0, n + 1)) + 1, top);
				await sleep(TYPE_MS);
			}
		};

		const run = async () => {
			// Boot: reveal the dashboard row by row.
			for (const [i, [label, value]] of dashboard.rows.entries()) {
				await typeRow(i, label, value);
				await sleep(ROW_GAP_MS);
			}

			// Live: the STATUS value keeps cycling, everything else stays put.
			const statusRow = dashboard.rows.length - 1;
			for (let s = 1; ; s = (s + 1) % dashboard.statuses.length) {
				await sleep(CYCLE_MS);
				await typeRow(statusRow, dashboard.rows[statusRow]![0], dashboard.statuses[s]!);
			}
		};

		run();
	}
</script>

<style>
	.terminal-art {
		width: 100%;
		height: auto;
		display: block;
	}

	.cursor {
		animation: cursor-blink 1.1s step-end infinite;
	}

	@keyframes cursor-blink {
		0%,
		100% {
			opacity: 1;
		}
		50% {
			opacity: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.cursor {
			animation: none;
		}
	}
</style>
