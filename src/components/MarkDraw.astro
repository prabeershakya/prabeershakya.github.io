---
/**
 * omarchy's "mark-draw": a rough marker stroke that draws itself under a word
 * when it scrolls into view.
 *
 * The stroke is one path with `pathLength` normalised to 100, so the dash
 * animation is written once regardless of the word's width. `preserveAspectRatio`
 * is none, so the same path stretches to any slot. Reduced motion and no-JS
 * leave the stroke fully drawn — the animation is an entrance, never a gate.
 */
const { color = "var(--brand)" } = Astro.props;
---

<span class="mark-draw">
	<slot />
	<svg class="mark" viewBox="0 0 100 9" preserveAspectRatio="none" aria-hidden="true">
		<path d="M2 6.5 Q 28 2 52 5 T 98 3.5" pathLength="100" style={`stroke:${color}`}></path>
	</svg>
</span>

<script>
	const draws = document.querySelectorAll<HTMLElement>(".mark-draw");
	if ("IntersectionObserver" in window) {
		const io = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting) {
						entry.target.classList.add("is-drawn");
						io.unobserve(entry.target);
					}
				}
			},
			{ rootMargin: "0px 0px -10% 0px" },
		);
		draws.forEach((el) => io.observe(el));
	} else {
		// No observer: show the stroke, skip the entrance.
		draws.forEach((el) => el.classList.add("is-drawn"));
	}
</script>

<style>
	.mark-draw {
		position: relative;
		display: inline-block;
	}

	.mark {
		position: absolute;
		left: -2%;
		right: -2%;
		width: 104%;
		height: 0.22em;
		bottom: -0.18em;
		overflow: visible;
	}

	.mark path {
		fill: none;
		stroke-width: 2.2;
		stroke-linecap: square;
	}

	@media (prefers-reduced-motion: no-preference) {
		.mark path {
			stroke-dasharray: 100;
			stroke-dashoffset: 100;
		}

		.mark-draw.is-drawn .mark path {
			transition: stroke-dashoffset 650ms cubic-bezier(0.2, 0, 0, 1) 150ms;
			stroke-dashoffset: 0;
		}
	}
</style>
