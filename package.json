{
	"name": "pixel-theme",
	"type": "module",
	"version": "0.0.1",
	"private": true,
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "npm run fetch:data && astro build",
		"build:offline": "SKIP_FETCH=1 astro build",
		"preview": "astro preview",
		"astro": "astro",
		"check": "astro check",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"verify": "npm run format:check && npm run check && npm run build:offline",
		"fetch:data": "node scripts/fetch-data.mjs"
	},
	"dependencies": {
		"@fontsource-variable/geist": "^5.2.5",
		"@fontsource-variable/jetbrains-mono": "^5.2.5",
		"astro": "^7.2.1"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@types/node": "^22.20.4",
		"prettier": "^3.9.9",
		"prettier-plugin-astro": "^1.1.0",
		"typescript": "^6.0.3"
	},
	"allowScripts": {
		"esbuild@0.28.2": true
	}
}
